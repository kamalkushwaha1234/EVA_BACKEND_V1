{
  "info": {
    "name": "EvaV1 API",
    "description": "Full API test collection for the EVA AI Flask backend — auth, devices, conversations, subscriptions, AI (STT/ASK/TTS), and the mTLS-gated device/OTA hardware APIs.\n\nSetup:\n1. Set `base_url` to your target (local: http://127.0.0.1:5000, deployed: http://evav1.ap-south-1.elasticbeanstalk.com).\n2. Run Auth > Register (or Login) first — it auto-saves access_token/refresh_token for every other request.\n3. For the mTLS-gated 'Device Hardware API' and 'OTA' folders, set `device_cert_fp` to a real device's cert_fp value from the devices table (in dev, this header substitutes for a real client certificate).\n4. Run requests top-to-bottom within a folder — later requests reuse variables (device_id, conv_id) captured from earlier ones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:5000" },
    { "key": "test_email", "value": "postman-test@example.com" },
    { "key": "test_password", "value": "TestPass123!" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "device_id", "value": "" },
    { "key": "device_serial", "value": "" },
    { "key": "claim_code", "value": "123456" },
    { "key": "device_cert_fp", "value": "" },
    { "key": "conv_id", "value": "" },
    { "key": "ota_version", "value": "1.0.1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"display_name\": \"Postman Test\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/auth/register", "host": ["{{base_url}}"], "path": ["v1", "auth", "register"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Register succeeded or already exists', () => [201, 409].includes(pm.response.code));",
                "if (pm.response.code === 201) {",
                "  const json = pm.response.json();",
                "  pm.collectionVariables.set('access_token', json.access_token);",
                "  pm.collectionVariables.set('refresh_token', json.refresh_token);",
                "  pm.collectionVariables.set('user_id', json.user.id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/auth/login", "host": ["{{base_url}}"], "path": ["v1", "auth", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Login succeeded', () => pm.response.code === 200);",
                "if (pm.response.code === 200) {",
                "  const json = pm.response.json();",
                "  pm.collectionVariables.set('access_token', json.access_token);",
                "  pm.collectionVariables.set('refresh_token', json.refresh_token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{refresh_token}}" }],
            "url": { "raw": "{{base_url}}/v1/auth/refresh", "host": ["{{base_url}}"], "path": ["v1", "auth", "refresh"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Refresh succeeded', () => pm.response.code === 200);",
                "if (pm.response.code === 200) {",
                "  const json = pm.response.json();",
                "  pm.collectionVariables.set('access_token', json.access_token);",
                "  pm.collectionVariables.set('refresh_token', json.refresh_token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": { "raw": "{{base_url}}/v1/auth/logout", "host": ["{{base_url}}"], "path": ["v1", "auth", "logout"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Logout succeeded (204)', () => pm.response.code === 204);"] }
          }]
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        {
          "name": "Claim Device",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serial\": \"{{device_serial}}\",\n  \"claim_code\": \"{{claim_code}}\",\n  \"name\": \"My Postman Device\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/devices/claim", "host": ["{{base_url}}"], "path": ["v1", "devices", "claim"] },
            "description": "device_serial must belong to an UNCLAIMED device (owner_id is null). Devices only exist after a hardware bootstrap call — see Device Hardware API > Bootstrap Device, or set device_serial to an existing unclaimed row in your DB."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) {",
                "  const json = pm.response.json();",
                "  pm.collectionVariables.set('device_id', json.id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "List Devices",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": { "raw": "{{base_url}}/v1/devices", "host": ["{{base_url}}"], "path": ["v1", "devices"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('List devices OK', () => pm.response.code === 200);"] }
          }]
        },
        {
          "name": "Get Device by ID",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": { "raw": "{{base_url}}/v1/devices/{{device_id}}", "host": ["{{base_url}}"], "path": ["v1", "devices", "{{device_id}}"] }
          }
        },
        {
          "name": "Update Device Name",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Renamed via Postman\"\n}" },
            "url": { "raw": "{{base_url}}/v1/devices/{{device_id}}", "host": ["{{base_url}}"], "path": ["v1", "devices", "{{device_id}}"] }
          }
        },
        {
          "name": "Send Device Command",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"set_volume\",\n  \"payload\": { \"level\": 70 }\n}" },
            "url": { "raw": "{{base_url}}/v1/devices/{{device_id}}/commands", "host": ["{{base_url}}"], "path": ["v1", "devices", "{{device_id}}", "commands"] },
            "description": "type must be one of: set_volume, set_led, reboot, mute, factory_reset, check_ota. reboot/factory_reset require the device to be online."
          }
        },
        {
          "name": "List Device Conversations",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": { "raw": "{{base_url}}/v1/devices/{{device_id}}/conversations", "host": ["{{base_url}}"], "path": ["v1", "devices", "{{device_id}}", "conversations"] }
          }
        },
        {
          "name": "Unclaim Device",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": { "raw": "{{base_url}}/v1/devices/{{device_id}}", "host": ["{{base_url}}"], "path": ["v1", "devices", "{{device_id}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('Unclaim succeeded (204)', () => pm.response.code === 204);"] }
          }]
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "Get Conversation Messages",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": {
              "raw": "{{base_url}}/v1/conversations/{{conv_id}}/messages?limit=100",
              "host": ["{{base_url}}"],
              "path": ["v1", "conversations", "{{conv_id}}", "messages"],
              "query": [{ "key": "limit", "value": "100" }]
            }
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Get My Subscription",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": { "raw": "{{base_url}}/v1/subscriptions/me", "host": ["{{base_url}}"], "path": ["v1", "subscriptions", "me"] }
          }
        },
        {
          "name": "Change Plan",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"plan\": \"plus\"\n}" },
            "url": { "raw": "{{base_url}}/v1/subscriptions/change", "host": ["{{base_url}}"], "path": ["v1", "subscriptions", "change"] },
            "description": "plan must be one of: free, plus, pro."
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Speech to Text (STT)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "lang", "type": "text", "value": "hi" },
                { "key": "conv_id", "type": "text", "value": "{{conv_id}}" }
              ]
            },
            "url": { "raw": "{{base_url}}/v1/ai/stt", "host": ["{{base_url}}"], "path": ["v1", "ai", "stt"] },
            "description": "Set the 'file' field to a local .wav file. conv_id is optional but required if you want the transcript tied to a conversation record."
          }
        },
        {
          "name": "Ask LLM",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the capital of France?\",\n  \"conv_id\": \"{{conv_id}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/ai/ask", "host": ["{{base_url}}"], "path": ["v1", "ai", "ask"] },
            "description": "Only writes to the messages table when conv_id is set to a real conversation owned by you (create one via Device Hardware API > Start Audio Session)."
          }
        },
        {
          "name": "Text to Speech (TTS)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello from Postman!\",\n  \"lang\": \"en\",\n  \"conv_id\": \"{{conv_id}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/ai/tts", "host": ["{{base_url}}"], "path": ["v1", "ai", "tts"] }
          }
        },
        {
          "name": "Reset Conversation",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "url": { "raw": "{{base_url}}/v1/ai/reset/{{conv_id}}", "host": ["{{base_url}}"], "path": ["v1", "ai", "reset", "{{conv_id}}"] }
          }
        },
        {
          "name": "Get Audio File",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/ai/audio/REPLACE_WITH_FILENAME.mp3", "host": ["{{base_url}}"], "path": ["v1", "ai", "audio", "REPLACE_WITH_FILENAME.mp3"] },
            "description": "Use the filename returned by Text to Speech. No auth required (public file serve)."
          }
        }
      ]
    },
    {
      "name": "Device Hardware API (mTLS)",
      "description": "These simulate the ESP32 device talking to the backend. In production, mTLS is terminated by nginx/ALB; in dev you substitute it by sending the device's stored cert_fp directly in X-SSL-Client-Fingerprint.",
      "item": [
        {
          "name": "Bootstrap Device",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-SSL-Client-Fingerprint", "value": "{{device_cert_fp}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serial\": \"{{device_serial}}\",\n  \"model\": \"eva-v1\",\n  \"fw_version\": \"1.0.0\",\n  \"hw_revision\": \"A\",\n  \"mac\": \"AA:BB:CC:DD:EE:FF\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/device/bootstrap", "host": ["{{base_url}}"], "path": ["v1", "device", "bootstrap"] },
            "description": "device_cert_fp must match an existing devices.cert_fp row in the DB (this endpoint does NOT create the device row itself)."
          }
        },
        {
          "name": "Start Audio Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-SSL-Client-Fingerprint", "value": "{{device_cert_fp}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"trigger\": \"wakeword\",\n  \"codec\": \"opus\",\n  \"sample_rate\": 16000\n}" },
            "url": { "raw": "{{base_url}}/v1/device/audio/session", "host": ["{{base_url}}"], "path": ["v1", "device", "audio", "session"] },
            "description": "Device must already be claimed (owner_id set). This is the only way conversation records get created."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.response.code === 201) {",
                "  const json = pm.response.json();",
                "  pm.collectionVariables.set('conv_id', json.conv_id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Heartbeat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-SSL-Client-Fingerprint", "value": "{{device_cert_fp}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fw_version\": \"1.0.0\",\n  \"uptime_s\": 3600,\n  \"wifi_rssi\": -55\n}" },
            "url": { "raw": "{{base_url}}/v1/device/heartbeat", "host": ["{{base_url}}"], "path": ["v1", "device", "heartbeat"] }
          }
        },
        {
          "name": "Upload Logs",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-SSL-Client-Fingerprint", "value": "{{device_cert_fp}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"periodic\",\n  \"entries\": [\n    { \"level\": \"info\", \"message\": \"boot ok\", \"ts\": \"2026-09-06T00:00:00Z\" }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/v1/device/logs", "host": ["{{base_url}}"], "path": ["v1", "device", "logs"] },
            "description": "reason must be one of: crash, error, periodic, requested."
          }
        }
      ]
    },
    {
      "name": "OTA (mTLS)",
      "item": [
        {
          "name": "Check for Update",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-SSL-Client-Fingerprint", "value": "{{device_cert_fp}}" }],
            "url": {
              "raw": "{{base_url}}/v1/ota/check?model=eva-v1&current=1.0.0&channel=stable",
              "host": ["{{base_url}}"],
              "path": ["v1", "ota", "check"],
              "query": [
                { "key": "model", "value": "eva-v1" },
                { "key": "current", "value": "1.0.0" },
                { "key": "channel", "value": "stable" }
              ]
            },
            "description": "204 No Content means no update available for this model/channel/rollout bucket."
          }
        },
        {
          "name": "Download Firmware Blob",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-SSL-Client-Fingerprint", "value": "{{device_cert_fp}}" }],
            "url": { "raw": "{{base_url}}/v1/ota/blob/{{ota_version}}", "host": ["{{base_url}}"], "path": ["v1", "ota", "blob", "{{ota_version}}"] },
            "description": "302 redirect to the release's blob_url. ota_version must match an existing ota_releases row."
          }
        }
      ]
    }
  ]
}
