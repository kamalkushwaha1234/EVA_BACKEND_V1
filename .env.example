SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# Local dev: leave DB_HOST unset and this sqlite URL is used.
DATABASE_URL=sqlite:///eva.db

# Deployment: set DB_HOST (and the rest below) to switch to PostgreSQL —
# this takes priority over DATABASE_URL. Leave DB_HOST empty locally.
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_NAME=eva
DB_USER=eva_app
DB_PASSWORD=change-me

MQTT_BROKER_HOST=mqtt.eva.ai
MQTT_BROKER_PORT=8883
REDIS_URL=memory://

# Azure OpenAI (via GitHub Models) — used by /v1/ai/ask
GITHUB_TOKEN=your-github-token-here
AZURE_ENDPOINT=https://models.github.ai/inference
AZURE_MODEL=openai/gpt-4o-mini

# Deepgram STT — used by /v1/ai/stt
DEEPGRAM_API_KEY=your-deepgram-api-key

# S3 (leave S3_BUCKET empty to use local file serving) — used by app/s3.py
S3_BUCKET=eva-backend-audio
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# AWS Polly TTS — used by /v1/ai/tts (app/api/v1/ai.py)
# Not read by app code directly; boto3 needs AWS credentials available via
# `aws configure`, an IAM instance role (preferred on EB/EC2), or the
# standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars.

# Device bridge (bridge.py)
API_BASE=http://127.0.0.1:5000
BRIDGE_EMAIL=bridge@eva.ai
BRIDGE_PASSWORD=change-me
MQTT_USER=toy
MQTT_PASS=change-me
UDP_PORT=5005
# Optional: override auto-detected public IP sent to devices in MQTT config
# PUBLIC_IP=203.0.113.10
